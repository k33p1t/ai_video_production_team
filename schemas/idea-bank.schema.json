{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Video Production Idea Bank",
  "description": "Persistent store of research ideas, niche topics, and cult/fan-following signals with weighted voting and slow time decay.",
  "type": "object",
  "required": ["schema_version", "updated_at", "config", "ideas"],
  "properties": {
    "schema_version": { "type": "string", "const": "1.0.0" },
    "updated_at": { "type": "string", "format": "date-time" },
    "config": {
      "type": "object",
      "required": ["human_vote_multiplier", "decay_percent_per_month", "auto_add_confidence_threshold"],
      "properties": {
        "human_vote_multiplier": { "type": "number", "default": 3.0 },
        "decay_percent_per_month": { "type": "number", "default": 12.0 },
        "auto_add_confidence_threshold": { "type": "number", "minimum": 0, "maximum": 1, "default": 0.65 },
        "top_n_dashboard": { "type": "integer", "default": 20 },
        "categories": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "ideas": {
      "type": "array",
      "items": { "$ref": "#/$defs/idea" }
    }
  },
  "$defs": {
    "idea": {
      "type": "object",
      "required": [
        "idea_id",
        "title",
        "summary",
        "category",
        "status",
        "created_at",
        "updated_at",
        "scores"
      ],
      "properties": {
        "idea_id": { "type": "string", "pattern": "^IDEA-[0-9]{4}-[0-9]{4}$" },
        "title": { "type": "string", "minLength": 3 },
        "summary": { "type": "string" },
        "category": {
          "type": "string",
          "enum": [
            "products",
            "movies_tv",
            "games",
            "tech_tools",
            "clothing_fashion",
            "vehicles",
            "music_artists",
            "creators_influencers",
            "events",
            "memes_trends",
            "other"
          ]
        },
        "tags": {
          "type": "array",
          "items": { "type": "string" }
        },
        "niche_signals": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Subcultures, communities, or fan languages that care about this"
        },
        "cult_fanboy_score": {
          "type": "number",
          "minimum": 0,
          "maximum": 10,
          "description": "How strong the almost-cult / fanboy following is (0=none, 10=extreme)"
        },
        "lifecycle": {
          "type": "string",
          "enum": ["past", "current", "upcoming", "rumored", "evergreen"]
        },
        "status": {
          "type": "string",
          "enum": ["active", "watching", "produced", "archived", "rejected", "merged"]
        },
        "confidence_at_intake": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "sources": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "url": { "type": "string" },
              "title": { "type": "string" },
              "observed_at": { "type": "string", "format": "date-time" },
              "platform": { "type": "string" }
            }
          }
        },
        "related_idea_ids": {
          "type": "array",
          "items": { "type": "string" }
        },
        "linked_project_ids": {
          "type": "array",
          "items": { "type": "string" }
        },
        "created_at": { "type": "string", "format": "date-time" },
        "updated_at": { "type": "string", "format": "date-time" },
        "last_decay_at": { "type": ["string", "null"], "format": "date-time" },
        "scores": {
          "type": "object",
          "required": ["agent_vote_sum", "human_vote_sum", "weighted_raw", "decayed_score", "rank_score"],
          "properties": {
            "agent_vote_sum": { "type": "number" },
            "human_vote_sum": { "type": "number" },
            "weighted_raw": {
              "type": "number",
              "description": "human_vote_sum * multiplier + agent_vote_sum"
            },
            "decayed_score": {
              "type": "number",
              "description": "weighted_raw after time decay"
            },
            "rank_score": {
              "type": "number",
              "description": "Final score used for Top 20 ranking (decayed_score + cult bonus + recency nudge)"
            },
            "vote_count_agent": { "type": "integer" },
            "vote_count_human": { "type": "integer" }
          }
        },
        "notes": { "type": "string" },
        "created_by": {
          "type": "string",
          "description": "agent_id or 'human'"
        }
      }
    }
  }
}
